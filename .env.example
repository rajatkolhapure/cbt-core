# Database connection string (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@localhost:5432/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cbt_db?schema=public"

# Authentication secret
JWT_SECRET="dev-secret-key-change-in-production"

# Server configuration
PORT=8080
HOST="0.0.0.0"
CLIENT_URL="http://localhost:8080"
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your_webhook_id/your_token"
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/XXXX"
GENERIC_WEBHOOK_URL="https://api.externalproctor.com/v1/integrity-events"
WEBHOOK_SECRET="super-secret-hmac-key"
GENERIC_WEBHOOK_HEADERS='{"Authorization": "Bearer sample_token_123"}'
